{
  "name": "open-whispr",
  "version": "1.10.5",
  "description": "OpenWhispr desktop dictation, notes and assistant powered by the supervised Nimi AI Runtime",
  "main": "dist-electron/main.js",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compile:globe": "node scripts/build-globe-listener.js",
    "compile:fast-paste": "node scripts/build-macos-fast-paste.js",
    "compile:winkeys": "node scripts/build-windows-key-listener.js",
    "compile:linuxkeys": "node scripts/build-linux-key-listener.js",
    "compile:text-monitor": "node scripts/build-text-monitor.js",
    "compile:winpaste": "node scripts/build-windows-fast-paste.js",
    "compile:linux-paste": "node scripts/build-linux-fast-paste.js",
    "compile:linux-system-audio": "node scripts/build-linux-system-audio.js",
    "compile:media-remote": "node scripts/build-media-remote.js",
    "compile:mediaremote-adapter": "node scripts/build-mediaremote-adapter.js",
    "compile:mic-listener": "node scripts/build-macos-mic-listener.js",
    "compile:calendar-listener": "node scripts/build-macos-calendar-listener.js",
    "compile:audio-tap": "node scripts/build-macos-audio-tap.js",
    "compile:window-bounds": "node scripts/build-macos-window-bounds.js",
    "compile:native": "npm run compile:globe && npm run compile:fast-paste && npm run compile:winkeys && npm run compile:linuxkeys && npm run compile:winpaste && npm run compile:linux-paste && npm run compile:linux-system-audio && npm run compile:text-monitor && npm run compile:media-remote && npm run compile:mediaremote-adapter && npm run compile:mic-listener && npm run compile:calendar-listener && npm run compile:audio-tap && npm run compile:window-bounds",
    "start": "nimi-app dev --shell electron",
    "dev": "nimi-app dev --shell electron",
    "dev:main": "nimi-app dev --shell electron",
    "dev:renderer": "vite --config src/vite.config.mjs src --host 127.0.0.1 --port 5183 --strictPort",
    "build": "pnpm run build:electron:production",
    "postinstall": "install-electron --no && electron-builder install-app-deps",
    "build:renderer": "cd src && vite build",
    "compile:mac-icon": "node scripts/compile-macos-icon.js",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:mac:arm64": "npm run build:renderer && electron-builder --mac --arm64",
    "build:mac:x64": "npm run build:renderer && electron-builder --mac --x64",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "build:linux:appimage": "npm run build:renderer && electron-builder --linux AppImage",
    "build:linux:deb": "npm run build:renderer && electron-builder --linux deb",
    "build:linux:rpm": "npm run build:renderer && electron-builder --linux rpm",
    "build:linux:tar": "npm run build:renderer && electron-builder --linux tar.gz",
    "pack": "nimi-app pack",
    "dist": "npm run build:renderer && electron-builder",
    "download:yt-dlp": "node scripts/download-yt-dlp.js --current",
    "download:yt-dlp:all": "node scripts/download-yt-dlp.js --all",
    "download:nircmd": "node scripts/download-nircmd.js",
    "download:windows-key-listener": "node scripts/download-windows-key-listener.js",
    "download:windows-mic-listener": "node scripts/download-windows-mic-listener.js",
    "download:windows-system-audio-helper": "node scripts/download-windows-system-audio-helper.js",
    "download:meeting-aec-helper": "node scripts/download-meeting-aec-helper.js --current",
    "download:meeting-aec-helper:all": "node scripts/download-meeting-aec-helper.js --all",
    "download:qdrant": "node scripts/download-qdrant.js --current",
    "download:qdrant:all": "node scripts/download-qdrant.js --all",
    "download:brand-fonts": "node scripts/download-brand-fonts.js",
    "format:js": "eslint . --fix && cd src && eslint . --fix && prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format": "npm run format:js",
    "format:check": "eslint . && cd src && eslint . && prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint": "eslint . && cd src && eslint .",
    "test": "pnpm rebuild better-sqlite3 && node --import tsx --test \"test/**/*.test.js\"",
    "typecheck": "pnpm run typecheck:renderer && pnpm run typecheck:host",
    "quality-check": "npm run format:check && npm run typecheck",
    "i18n:check": "node scripts/check-i18n.js",
    "preview": "cd src && vite preview",
    "clean": "node cleanup.js",
    "test:app": "pnpm run test",
    "build:electron": "pnpm run rebuild:electron-native && node scripts/build-nimi-host.mjs",
    "build:electron:production": "pnpm run prepare:windows && pnpm run build:renderer && pnpm run build:electron && electron-builder --win --dir --config electron-builder.unsigned-win.json",
    "prepare:windows": "pnpm run compile:winkeys && pnpm run compile:winpaste && cross-env CI=true node scripts/download-windows-mic-listener.js && pnpm run download:yt-dlp && cross-env QDRANT_VERSION=v1.19.2 node scripts/download-qdrant.js --current && electron-rebuild --force --only better-sqlite3",
    "dev:shell": "nimi-app dev",
    "dev:electron": "nimi-app dev --shell electron",
    "sync": "nimi-app sync",
    "typecheck:renderer": "cd src && tsc --noEmit",
    "typecheck:host": "tsc --allowJs --checkJs false --noEmit --skipLibCheck --target es2022 --module nodenext --moduleResolution nodenext src/helpers/nimiEmbeddings.js src/helpers/vectorIndex.js src/helpers/nimiMeetingTranscript.js src/helpers/speakerEmbeddings.js",
    "rebuild:electron-native": "electron-rebuild --force --only better-sqlite3"
  },
  "keywords": [
    "dictation",
    "speech-to-text",
    "whisper",
    "whisper.cpp",
    "electron",
    "desktop-app"
  ],
  "author": "OpenWhispr Team <support@openwhispr.com>",
  "license": "MIT",
